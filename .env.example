# Business-OS-Datenbank (Supabase, Transaction pooler), Login mit Rolle bos_automation
ACQ_DATABASE_URL=postgresql://LOGIN.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Optional: eigene CA, falls Supabase die Root-CA wechselt (PEM oder Pfad)
# ACQ_DATABASE_CA_CERT=

# Login: name:scrypt:<salt>:<hash>, mehrere mit Komma. Hash: npm run user:hash -- <name>
LETTERFLOW_USERS=
# Mindestens 32 zufällige Zeichen, z. B. openssl rand -base64 48
LETTERFLOW_SESSION_SECRET=

# Angebundene Systeme (nur Secrets; URL, Organisation usw. stehen unter "Systeme" in der App)
DIRECTUS_SETUP_TOKEN=
PINGEN_CLIENT_ID=
PINGEN_CLIENT_SECRET=
TYPESAFE_API_KEY=
